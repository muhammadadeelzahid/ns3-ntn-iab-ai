<mxfile host="app.diagrams.net" type="device">
  <diagram name="V2 - Pretrained LLM + LoRA" id="v2">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="V2 — Pretrained LLM with LoRA (Soft-Token Injection)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="610" height="30" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="in_net" value="network_norm&#10;[B, 7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="in_sem" value="semantic_norm&#10;[B, 5]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="in_lad" value="ladder_context&#10;[B, 6, 2]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Encoder group box -->
        <mxCell id="enc_grp" value="MultimodalEncoder (identical to V0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="610" height="300" as="geometry" />
        </mxCell>

        <!-- Branches -->
        <mxCell id="br_net" value="Network CNN&#10;Conv1d(7→128, k=3) + Sigmoid Linear Unit + Dropout(0.1)&#10;Conv1d(128→128, k=3) + Sigmoid Linear Unit&#10;AdaptiveAvgPool1d(1)&#10;LayerNorm(128)&#10;→ net_emb [B, 128]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="br_sem" value="Semantic MLP&#10;Linear(5→64) + Sigmoid Linear Unit + LN + Dropout(0.1)&#10;Linear(64→64) + Sigmoid Linear Unit + LN&#10;→ sem_emb [B, 64]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="235" y="170" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="br_lad" value="Ladder Proj&#10;Linear(2→32) + Sigmoid Linear Unit (per rung)&#10;mean over 6 rungs&#10;→ ldr_emb [B, 32]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- Fuse -->
        <mxCell id="fuse" value="Concat [B, 224]&#10;Linear(224 → 256)&#10;→ e_fused [B, 256]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="175" y="350" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Soft token projector -->
        <mxCell id="soft" value="SoftTokenProjection&#10;Linear(256 → 4 × 1536)&#10;reshape → soft_tokens [B, 4, 1536]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="165" y="470" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- LLM backbone -->
        <mxCell id="llm" value="Qwen2.5-1.5B-Instruct  (frozen base, ~1.54B params)&#10;input: inputs_embeds = soft_tokens  (no tokenizer / input_ids)&#10;attention_mask = ones [B, 4]&#10;&#10;28 × Transformer block:&#10;  LayerNorm → GQA (12 heads / 2 KV heads)&#10;  SwiGLU FFN (intermediate = 8960)&#10;Hidden size H = 1536&#10;&#10;LoRA adapters (trainable): r=16, α=32, dropout=0.05&#10;  on q/k/v/o/gate/up/down _proj&#10;QLoRA 4-bit NF4 + double-quant, bf16 compute&#10;&#10;output: hidden_states[-1] [B, 4, 1536]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="570" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- Pooling -->
        <mxCell id="pool" value="Mean-pool over 4 soft-token positions&#10;→ pooled [B, 1536]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="175" y="820" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Policy head -->
        <mxCell id="head" value="Policy Head&#10;Linear(1536 → 256) + Sigmoid Linear Unit + Dropout(0.1)&#10;Linear(256 → 128) + Sigmoid Linear Unit&#10;Linear(128 → 6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="165" y="910" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="out" value="logits [B, 6]&#10;(6-rung bitrate ladder)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="1040" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="in_net" target="br_net"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="in_sem" target="br_sem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="in_lad" target="br_lad"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="br_net" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="br_sem" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="br_lad" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="fuse" target="soft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="soft" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="llm" target="pool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="pool" target="head"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="head" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
