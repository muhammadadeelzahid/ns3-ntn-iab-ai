<mxfile host="app.diagrams.net">
    <diagram name="LLM-ABR v2 architecture" id="llmabrv2">
        <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="LLM-ABR — multimodal ABR policy (variant v2)&#10;encoder to soft-tokens to frozen LLM + LoRA to residual skip to policy head" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="120" y="10" width="660" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="in_net" value="Network state  [B, W, 7]&#10;&#10;throughput_est, buffer_level, buffer_diff,&#10;fetch_time, last_seg_bitrate, rtt, loss_rate&#10;(z-scored, window W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="in_sem" value="Content / semantic  [B, 5]&#10;&#10;motion, saliency, scene_cuts,&#10;object_score, quality_sensitivity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="330" y="80" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="in_lad" value="Ladder context  [B, 6, 2]&#10;&#10;per-rung (size_bytes, VMAF)&#10;6 bitrate rungs 0.25 - 12 Mbps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="80" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="enc_net" value="Network 1D-CNN&#10;Conv1d(7 to 128, k3), SiLU, Dropout&#10;Conv1d(128 to 128, k3), SiLU&#10;AdaptiveAvgPool1d(1), LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="240" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="enc_sem" value="Semantic MLP&#10;Linear(5 to 64), SiLU, LN, Dropout&#10;Linear(64 to 64), SiLU, LN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="330" y="240" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="enc_lad" value="Ladder proj&#10;Linear(2 to 32), SiLU&#10;mean-pool over 6 rungs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="240" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="emb_net" value="net_emb  [128]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaffea;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="390" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="emb_sem" value="sem_emb  [64]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaffea;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="390" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="emb_lad" value="ladder_emb  [32]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaffea;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="660" y="390" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="fuse" value="Concat [128+64+32 = 224]  to  Fuse Linear(224 to 256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="230" y="460" width="440" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="efused" value="e_fused  [B, 256]&#10;(fused multimodal state embedding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3a0;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="290" y="550" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="soft" value="SoftTokenProjection&#10;Linear(256 to k*H), reshape [B, k=4, H]&#10;per-token LayerNorm  (in-distribution scale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="270" y="650" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="llm" value="LLM backbone — Qwen2.5-1.5B-Instruct&#10;base FROZEN + LoRA (QLoRA 4-bit)&#10;inputs_embeds = soft_tokens [B, 4, H]&#10;transformer to last hidden [B, 4, H]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="250" y="760" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="pool" value="mean-pool over k soft tokens  to  pooled [B, H]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="270" y="900" width="360" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="concat" value="Residual concat:  [ pooled (H) , e_fused (256) ]&#10;direct un-throttled encoder path — prevents prior-collapse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="250" y="980" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="head" value="Policy head (AbrPolicyHead)&#10;Linear(H+256 to 256), SiLU, Dropout&#10;Linear(256 to 128), SiLU&#10;bitrate_head: Linear(128 to 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="290" y="1080" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="out" value="logits [B, 6]  to  argmax rung&#10;bitrate decision over the 6-rung ladder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="300" y="1220" width="300" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="v3note" value="v3 extension: after the 4 soft tokens, concatenate per-video language-token&#10;embeddings: seq = [soft_0..soft_3 , text_0..text_L] then masked-mean-pool, same head.&#10;v0 = encoder to head, no LLM." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="30" y="760" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="in_net" target="enc_net" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="in_sem" target="enc_sem" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="in_lad" target="enc_lad" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="enc_net" target="emb_net" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="enc_sem" target="emb_sem" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="enc_lad" target="emb_lad" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="emb_net" target="fuse" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="emb_sem" target="fuse" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="emb_lad" target="fuse" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="fuse" target="efused" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="efused" target="soft" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="soft" target="llm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="llm" target="pool" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="pool" target="concat" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="concat" target="head" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="head" target="out" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eskip" value="residual skip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="efused" target="concat" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
